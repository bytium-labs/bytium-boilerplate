{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./*"]
    },
    "outDir": "../../dist/server",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["@citizenfx/server", "@types/node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./**/*"],
  "exclude": ["**/node_modules"]
}
